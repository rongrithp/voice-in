[Unit]
Description=Voice Operating Hub — Zero-UI Real-Time Multimodal Personal Co-pilot
After=network.target network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=voicein
Group=voicein
WorkingDirectory=/opt/voice-in
EnvironmentFile=-/opt/voice-in/.env
ExecStart=/opt/voice-in/.venv/bin/python main.py --daemon
Restart=always
RestartSec=3s
LimitNOFILE=65536

# Hardening Directives
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
